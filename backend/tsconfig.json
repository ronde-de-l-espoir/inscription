{
    "compilerOptions": {
        "target": "ES6",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "moduleResolution": "node"
    },
    //"include": ["./**/*", "../shared/src/booking.ts", "../shared/src/event.ts", "../shared/src/member.ts"],
    "include": ["./**/*"],
    "exclude": ["node_modules", "**/*.spec.ts"]
}