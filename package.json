{
    "name": "inscription-evenements",
    "private": true,
    "scripts": {
        "dev:frontend": "cross-env NODE_ENV=development pnpm --filter frontend dev",
        "dev:backend": "cross-env NODE_ENV=development pnpm --filter backend dev",
        "dev": "cross-env NODE_ENV=development concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
        "build:frontend": "cross-env NODE_ENV=production pnpm --filter frontend build",
        "build:backend": "cross-env NODE_ENV=production pnpm --filter backend build",
        "build": "cross-env NODE_ENV=production pnpm build:frontend && pnpm build:backend",
        "buildScript": "cd ./scripts && start powershell ./bundler.ps1"
    },
    "devDependencies": {
        "concurrently": "^6.2.1",
        "cross-env": "^7.0.3"
    },
    "dependencies": {
        "dotenv": "^16.4.7"
    },
    "packageManager": "pnpm@11.1.3"
}
